<?xml version="1.0" encoding="utf-8" ?>
<widget
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="mxtechies.audittimeline.AuditTimeline"
    pluginWidget="true"
    needsEntityContext="false"
    offlineCapable="true"
    supportedPlatform="Web"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">

    <name>Audit Timeline</name>

    <description>
        Displays audit history as a timeline
    </description>

    <icon />

    <properties>
        <propertyGroup caption="Data source">

            <property key="dataSource" type="datasource" isList="true">
                <caption>Audit history</caption>
                <description>
                    List of audit history records to display.
                </description>
            </property>

        </propertyGroup>

        <propertyGroup caption="Audit fields">

            <property key="action" type="attribute" dataSource="dataSource">
                <caption>Action</caption>
                <description>Audit action such as Created, Updated or Deleted.</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>

            <property key="user" type="attribute" dataSource="dataSource">
                <caption>User</caption>
                <description>User who performed the action.</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>

            <property key="changedDateTime" type="attribute" dataSource="dataSource">
                <caption>Changed Date Time</caption>
                <description>Date and time when the change occurred.</description>
                <attributeTypes>
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            
            <property key="objectName" type="attribute" dataSource="dataSource">
                <caption>Object Name</caption>
                <description>Object that was changed.</description>
                <attributeTypes>
                    <attributeType name="String" />
                 </attributeTypes>
            </property>

            <property key="attributeName" type="attribute" dataSource="dataSource">
                <caption>Attribute Name</caption>
                <description>Name of the changed attribute.</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>

            <property key="oldValue" type="attribute" dataSource="dataSource">
                <caption>Old Value</caption>
                <description>Value before the change.</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>

            <property key="newValue" type="attribute" dataSource="dataSource">
                <caption>New Value</caption>
                <description>Value after the change.</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>

            <property key="description" type="attribute" dataSource="dataSource">
                <caption>Description</caption>
                <description>Additional audit description.</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>

        </propertyGroup>

    </properties>

</widget>